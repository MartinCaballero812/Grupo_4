<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="FacturacionPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.facturacion.entidades.Usuario</class>
        <class>com.facturacion.entidades.FacturaVenta</class>
        <class>com.facturacion.entidades.FacturaVentaDetalle</class>
        <class>com.facturacion.entidades.PuntoVenta</class>
        <class>com.facturacion.entidades.TipoMoneda</class>
        <class>com.facturacion.entidades.Cliente</class>
        <class>com.facturacion.entidades.CondicionIva</class>
        <class>com.facturacion.entidades.Contacto</class>
        <class>com.facturacion.entidades.Domicilio</class>
        <class>com.facturacion.entidades.ListaPrecioArticulo</class>
        <class>com.facturacion.entidades.ListaPrecio</class>
        <class>com.facturacion.entidades.Articulo</class>
        <class>com.facturacion.entidades.Marca</class>
        <class>com.facturacion.entidades.Rubro</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- Conexión JDBC a PostgreSQL -->
            <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="javax.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/facturacion"/>
            <property name="javax.persistence.jdbc.user" value="postgres"/>
            <property name="javax.persistence.jdbc.password" value="Facusg123."/>

            <!-- Propiedades de Hibernate -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>
